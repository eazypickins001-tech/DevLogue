# Access protection (required)
APP_PASSWORD=
AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=DevLogue <onboarding@resend.dev>
OWNER_EMAIL=you@example.com
APP_PUBLIC_URL=

# Database (required for persistence) - Neon Postgres
DATABASE_URL=

# Media storage (optional; uploads disabled until set) - Cloudflare R2 S3 API
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI provider (optional; analysis and content generation disabled until set)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_ANALYSIS=
AI_MODEL_CONTENT=

# GoHighLevel publishing (optional; phase 4)
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_USER_ID=
GHL_DEFAULT_ACCOUNT_IDS=
GHL_TEST_MODE=true

# Local render worker (optional; only used by scripts/render-worker.mjs)
WHISPER_MODEL=base.en
FFMPEG_PATH=
FFPROBE_PATH=
RENDER_FONT=

# Worker control (optional; enables Start/Stop worker buttons)
WORKER_CONTROL_HOST=127.0.0.1
WORKER_CONTROL_PORT=4100
WORKER_CONTROL_URL=http://127.0.0.1:4100
WORKER_CONTROL_TOKEN=
WORKER_CONTROL_AUTOSTART=true

# Storage warning threshold (bytes; default 8 GiB)
STORAGE_WARNING_BYTES=8589934592

# Error event retention and cron auth
ERROR_EVENT_RETENTION_DAYS=90
CRON_SECRET=
